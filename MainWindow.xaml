<Window x:Class="TraSuaApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Say Tea Coffee - Đăng Nhập" Height="600" Width="500" WindowStartupLocation="CenterScreen" Background="White">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="45"/>
            <Setter Property="Padding" Value="15,10,15,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="45"/>
            <Setter Property="Padding" Value="15,10,15,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <StackPanel VerticalAlignment="Center" Margin="0">
            <!-- Top Section: Logo & Branding -->
            <Border Background="#00704A" Padding="40,50,40,40">
                <StackPanel HorizontalAlignment="Center">
                    <!-- Logo Image -->
                    <Border Width="120" Height="120" HorizontalAlignment="Center" Margin="0,0,0,20" Background="White" CornerRadius="60" ClipToBounds="True">
                        <Image Source="Assets/logo.jpg" Height="120" Width="120" HorizontalAlignment="Center" Stretch="UniformToFill"/>
                    </Border>
                    
                    <!-- Title -->
                    <TextBlock Text="Say Tea Coffee" FontSize="32" FontWeight="Bold" Foreground="White" 
                               HorizontalAlignment="Center" Margin="0,0,0,5" TextAlignment="Center"/>
                    <TextBlock Text="Hệ Thống Quản Lý Quán Trà Sữa" FontSize="13" Foreground="#D0D0D0" 
                               HorizontalAlignment="Center" FontStyle="Italic" TextAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Middle Section: Login Form -->
            <Border Padding="40,35,40,35" Background="White" Height="361" Width="501">
                <StackPanel>
                    <!-- Username Field -->
                    <TextBlock Text="Tài Khoản" FontSize="12" FontWeight="SemiBold" Foreground="#00704A" Margin="0,0,0,8"/>
                    <TextBox Name="txtUsername" Margin="0,0,0,20" Text=""/>
                    
                    <!-- Password Field -->
                    <TextBlock Text="Mật Khẩu" FontSize="12" FontWeight="SemiBold" Foreground="#00704A" Margin="0,0,0,8"/>
                    <PasswordBox Name="txtPassword" Margin="0,0,0,30"/>
                    
                    <!-- Login Button -->
                    <Button Content="ĐĂNG NHẬP" Height="50" Background="#00704A" Foreground="White" 
                            FontSize="15" FontWeight="Bold" Cursor="Hand" Click="btnLogin_Click"
                            Margin="0,0,0,15">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="5"
                                                    BorderThickness="0">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#005A3D"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#004630"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    
                    <!-- Info Text -->
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
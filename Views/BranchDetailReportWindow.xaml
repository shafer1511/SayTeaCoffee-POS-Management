<Window x:Class="TraSuaApp.Views.BranchDetailReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Báo Cáo Chi Nhánh" Height="780" Width="980" WindowStartupLocation="CenterOwner"
        Background="#F5F5F5" ResizeMode="CanResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Báo Cáo Chi Nhánh" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#00704A" Margin="0,0,0,12"/>

        <Border Grid.Row="1" Background="White" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                    <TextBlock Text="Chi nhánh:" FontWeight="SemiBold" Foreground="#555"/>
                    <TextBlock x:Name="txtBranchName" FontSize="15" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,8">
                    <TextBlock Text="Kỳ báo cáo:" FontWeight="SemiBold" Foreground="#555"/>
                    <TextBlock x:Name="txtReportPeriod" FontSize="14"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Tổng doanh thu:" FontWeight="SemiBold" Foreground="#555"/>
                    <TextBlock x:Name="txtTotalRevenue" FontSize="16" FontWeight="Bold" Foreground="#007BFF"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="Tổng đơn hàng:" FontWeight="SemiBold" Foreground="#555"/>
                    <TextBlock x:Name="txtTotalOrders" FontSize="16" FontWeight="Bold" Foreground="#333"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <GroupBox Grid.Column="0" Header="Top 5 sản phẩm bán chạy" FontWeight="Bold" Margin="0,0,8,0" Padding="8" Background="White" BorderBrush="#E0E0E0">
                <DataGrid x:Name="dgTopSelling" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          RowHeight="28" FontSize="12" BorderThickness="0" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="80"/>
                        <DataGridTextColumn Header="Tên sản phẩm" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Đã bán" Binding="{Binding SoldQty}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
            <GroupBox Grid.Column="1" Header="Sản phẩm sắp hết hàng/ hết hàng" FontWeight="Bold" Margin="8,0,0,0" Padding="8" Background="White" BorderBrush="#E0E0E0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="dgLowStock" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              RowHeight="28" FontSize="12" BorderThickness="0" Margin="0,0,0,10" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="80"/>
                            <DataGridTextColumn Header="Tên" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Tồn kho" Binding="{Binding Stock}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Số lượng:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
                        <TextBox x:Name="txtRestockQty" Width="100" Height="32" Text="100" VerticalContentAlignment="Center" Padding="6,0"/>
                        <Button x:Name="btnSupply" Content="Cung Cấp" Margin="12,0,0,0" Padding="20,8" FontWeight="Bold" Foreground="White"
                                Background="#28A745" Cursor="Hand" Click="btnSupply_Click"/>
                    </StackPanel>
                </Grid>
            </GroupBox>
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <GroupBox Grid.Column="0" Header="🍹 Nước uống (menu chi nhánh)" FontWeight="Bold" Margin="0,0,8,0" Padding="8" Background="White" BorderBrush="#E0E0E0">
                <DataGrid x:Name="dgMenuDrinks" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          RowHeight="26" FontSize="12" BorderThickness="0" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70"/>
                        <DataGridTextColumn Header="Tên" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Giá" Binding="{Binding BasePrice, StringFormat=N0}" Width="80"/>
                        <DataGridTextColumn Header="Tồn" Binding="{Binding Stock}" Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
            <GroupBox Grid.Column="1" Header="🍨 Topping (menu chi nhánh)" FontWeight="Bold" Margin="8,0,0,0" Padding="8" Background="White" BorderBrush="#E0E0E0">
                <DataGrid x:Name="dgMenuToppings" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          RowHeight="26" FontSize="12" BorderThickness="0" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70"/>
                        <DataGridTextColumn Header="Tên" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Giá" Binding="{Binding BasePrice, StringFormat=N0}" Width="80"/>
                        <DataGridTextColumn Header="Tồn" Binding="{Binding Stock}" Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>

        <Button Grid.Row="4" Content="Quay về" HorizontalAlignment="Left" Width="120" Height="38" Background="#6C757D" Foreground="White" FontWeight="Bold" Click="btnBack_Click"/>
    </Grid>
</Window>

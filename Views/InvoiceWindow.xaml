<Window x:Class="TraSuaApp.Views.InvoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hóa Đơn Thanh Toán" Width="450" MinHeight="320" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" Background="#F4F4F4" MaxHeight="900">
    <Border Background="White" Margin="20" Padding="20" CornerRadius="5" BorderBrush="#CCCCCC" BorderThickness="1"
            VerticalAlignment="Top">
        <Grid VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,20">
                <TextBlock Text="HÓA ĐƠN THANH TOÁN" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="===============================" Foreground="Gray" HorizontalAlignment="Center" Margin="0,5"/>
                <TextBlock Name="txtStore" Text="Chi nhánh: " FontSize="14" HorizontalAlignment="Center"/>
                <TextBlock Name="txtCashier" Text="Thu ngân: " FontSize="14" HorizontalAlignment="Center"/>
                <TextBlock Name="txtDate" Text="Thời gian: " FontSize="14" HorizontalAlignment="Center" Foreground="Gray"/>
                <TextBlock Text="---------------------------------------------------" Foreground="Gray" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="360" HorizontalScrollBarVisibility="Disabled"
                          Padding="0" Margin="0,4,0,0">
                <ItemsControl x:Name="lvInvoice" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" Margin="0,5"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                <TextBlock Text="---------------------------------------------------" Foreground="Gray" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <Grid Width="350" Margin="0,5">
                    <TextBlock Text="Tổng tiền:" FontSize="16" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="txtTotal" Text="0 đ" FontSize="16" HorizontalAlignment="Right"/>
                </Grid>
                <Grid Width="350" Margin="0,5">
                    <TextBlock Text="Giảm giá:" FontSize="16" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="txtDiscount" Text="0 đ" FontSize="16" HorizontalAlignment="Right"/>
                </Grid>
                <Grid Width="350" Margin="10,10,0,20">
                    <TextBlock Text="CẦN THANH TOÁN:" FontSize="18" FontWeight="Bold" HorizontalAlignment="Left"/>
                    <TextBlock Name="txtFinal" Text="0 đ" FontSize="20" FontWeight="Bold" HorizontalAlignment="Right" Foreground="#D32F2F"/>
                </Grid>
                <Button Content="🖨️ IN HÓA ĐƠN &amp; ĐÓNG" Height="45" Background="#28A745" Foreground="White" FontWeight="Bold" FontSize="16" Cursor="Hand" Click="btnPrint_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
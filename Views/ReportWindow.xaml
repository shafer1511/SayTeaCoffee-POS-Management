<Window x:Class="TraSuaApp.Views.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gửi Báo Cáo Về Trung Tâm" Height="400" Width="450" WindowStartupLocation="CenterScreen" Background="#F4F6F8">
    <Border Background="White" Margin="15" Padding="20" CornerRadius="8" BorderBrush="#DDD" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="ĐIỀN THÔNG TIN SỰ CỐ" FontSize="18" FontWeight="Bold" Foreground="#D32F2F" HorizontalAlignment="Center" Margin="0,0,0,20"/>
            
            <TextBlock Text="Loại sự cố:" FontWeight="Bold" Margin="0,0,0,5"/>
            <ComboBox Name="cbReportType" Height="35" FontSize="14" Margin="0,0,0,15">
                <ComboBoxItem Content="Hết nguyên liệu / Sắp hết kho" IsSelected="True"/>
                <ComboBoxItem Content="Sự cố máy móc / Thiết bị POS"/>
                <ComboBoxItem Content="Xin hỗ trợ nhân sự"/>
                <ComboBoxItem Content="Phản ánh của khách hàng"/>
                <ComboBoxItem Content="Sự cố khác..."/>
            </ComboBox>

            <TextBlock Text="Mô tả chi tiết:" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox Name="txtMessage" Height="100" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="5" FontSize="14" Margin="0,0,0,20"/>

            <Button Content="GỬI BÁO CÁO NGAY" Height="45" Background="#007BFF" Foreground="White" FontSize="16" FontWeight="Bold" Cursor="Hand" Click="btnSubmit_Click"/>
        </StackPanel>
    </Border>
</Window>